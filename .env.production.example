APP_ENV=production
APP_DEBUG=false
APP_NAME=ALPR STMS Hawassa
APP_PUBLIC_URL=https://alpr-stms.example.com
APP_SECRET_KEY=replace-with-production-secret
APP_HTTP_PORT=8080
SESSION_COOKIE_NAME=alpr_session
SESSION_TTL_HOURS=12
DEFAULT_TIMEZONE=Africa/Addis_Ababa

POSTGRES_HOST=supabase-db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=replace-with-production-postgres-password
DB_APP_USER=app_user
DB_APP_USER_PASSWORD=replace-with-production-app-password
DB_WORKER_USER=worker_user
DB_WORKER_USER_PASSWORD=replace-with-production-worker-password
DB_AUTHENTICATOR_USER=authenticator
DB_AUTHENTICATOR_USER_PASSWORD=replace-with-production-authenticator-password
DB_STORAGE_USER=supabase_storage_admin
DB_STORAGE_USER_PASSWORD=replace-with-production-storage-password

DATABASE_URL=postgresql+psycopg://app_user:replace-with-production-app-password@supabase-db:5432/postgres
WORKER_DATABASE_URL=postgresql+psycopg://worker_user:replace-with-production-worker-password@supabase-db:5432/postgres
ALEMBIC_DATABASE_URL=postgresql+psycopg://app_user:replace-with-production-app-password@supabase-db:5432/postgres
POSTGREST_DATABASE_URL=postgres://authenticator:replace-with-production-authenticator-password@supabase-db:5432/postgres
STORAGE_DATABASE_URL=postgres://supabase_storage_admin:replace-with-production-storage-password@supabase-db:5432/postgres

JWT_SECRET=replace-with-production-jwt-secret
JWT_EXPIRY=3600
ANON_KEY=replace-with-production-anon-key
SERVICE_ROLE_KEY=replace-with-production-service-role-key
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_EXTRA_SEARCH_PATH=public
PGRST_DB_MAX_ROWS=1000

STORAGE_BUCKET=violation-evidence
STORAGE_TENANT_ID=alpr-stms-hawassa
STORAGE_PUBLIC_URL=https://alpr-stms.example.com/storage
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
GLOBAL_S3_BUCKET=violation-evidence
REGION=production
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-production-s3-access-key
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-production-s3-secret
IMGPROXY_AUTO_WEBP=true

PAYMENT_CALLBACK_SHARED_SECRET=replace-with-production-payment-secret
PAYMENT_PROVIDER_MODE=live

SMTP_HOST=replace-with-production-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-production-smtp-user
SMTP_PASS=replace-with-production-smtp-pass
SMTP_FROM=no-reply@alpr-stms.example.com

MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

WORKER_POLL_SECONDS=10
WORKER_BATCH_SIZE=50
OFFICER_DEFAULT_PASSWORD=tp1alprstms
ADMIN_DEFAULT_PASSWORD=admin1alprstms
COMPLAINT_DEFAULT_PASSWORD=co1alprstms
SUBCITY_DEFAULT_PASSWORD=sc1alprstms

MAILHOG_HTTP_PORT=8025
MAILHOG_SMTP_PORT=1025

