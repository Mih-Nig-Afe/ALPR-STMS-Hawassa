APP_ENV=staging
APP_DEBUG=false
APP_NAME=ALPR STMS Hawassa
APP_PUBLIC_URL=https://staging.alpr-stms.example.com
APP_SECRET_KEY=replace-with-staging-secret
APP_HTTP_PORT=8080
SESSION_COOKIE_NAME=alpr_session
SESSION_TTL_HOURS=12
DEFAULT_TIMEZONE=Africa/Addis_Ababa

POSTGRES_HOST=supabase-db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=replace-with-staging-postgres-password
DB_APP_USER=app_user
DB_APP_USER_PASSWORD=replace-with-staging-app-password
DB_WORKER_USER=worker_user
DB_WORKER_USER_PASSWORD=replace-with-staging-worker-password
DB_AUTHENTICATOR_USER=authenticator
DB_AUTHENTICATOR_USER_PASSWORD=replace-with-staging-authenticator-password
DB_STORAGE_USER=supabase_storage_admin
DB_STORAGE_USER_PASSWORD=replace-with-staging-storage-password

DATABASE_URL=postgresql+psycopg://app_user:replace-with-staging-app-password@supabase-db:5432/postgres
WORKER_DATABASE_URL=postgresql+psycopg://worker_user:replace-with-staging-worker-password@supabase-db:5432/postgres
ALEMBIC_DATABASE_URL=postgresql+psycopg://app_user:replace-with-staging-app-password@supabase-db:5432/postgres
POSTGREST_DATABASE_URL=postgres://authenticator:replace-with-staging-authenticator-password@supabase-db:5432/postgres
STORAGE_DATABASE_URL=postgres://supabase_storage_admin:replace-with-staging-storage-password@supabase-db:5432/postgres

JWT_SECRET=replace-with-staging-jwt-secret
JWT_EXPIRY=3600
ANON_KEY=replace-with-staging-anon-key
SERVICE_ROLE_KEY=replace-with-staging-service-role-key
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_EXTRA_SEARCH_PATH=public
PGRST_DB_MAX_ROWS=1000

STORAGE_BUCKET=violation-evidence-staging
STORAGE_TENANT_ID=alpr-stms-hawassa-staging
STORAGE_PUBLIC_URL=https://staging.alpr-stms.example.com/storage
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
GLOBAL_S3_BUCKET=violation-evidence-staging
REGION=staging
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-staging-s3-access-key
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-staging-s3-secret
IMGPROXY_AUTO_WEBP=true

PAYMENT_CALLBACK_SHARED_SECRET=replace-with-staging-payment-secret
PAYMENT_PROVIDER_MODE=mock

SMTP_HOST=replace-with-staging-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-staging-smtp-user
SMTP_PASS=replace-with-staging-smtp-pass
SMTP_FROM=no-reply@staging.alpr-stms.example.com

MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

WORKER_POLL_SECONDS=10
WORKER_BATCH_SIZE=25
OFFICER_DEFAULT_PASSWORD=tp1alprstms
ADMIN_DEFAULT_PASSWORD=admin1alprstms
COMPLAINT_DEFAULT_PASSWORD=co1alprstms
SUBCITY_DEFAULT_PASSWORD=sc1alprstms

MAILHOG_HTTP_PORT=8025
MAILHOG_SMTP_PORT=1025

